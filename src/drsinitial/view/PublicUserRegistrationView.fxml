<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1150.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="drsinitial.controller.PublicUserRegistrationController">

    <center>
        <HBox alignment="CENTER" spacing="0.0" styleClass="login-root">

            <VBox alignment="CENTER_LEFT" spacing="18.0"
                  prefWidth="520.0"
                  styleClass="login-brand-panel">

                <Label text="Public User Registration"
                       wrapText="true"
                       styleClass="registration-brand-title" />

                <Label text="CrisisOps"
                       styleClass="login-brand-subtitle" />

                <Label text="Create a public account to report disasters and view published emergency alerts."
                       wrapText="true"
                       styleClass="login-brand-description" />

                <VBox spacing="8.0" styleClass="login-info-box">
                    <Label text="Account access"
                           styleClass="login-info-title" />
                    <Label text="This form creates PUBLIC_USER accounts only."
                           wrapText="true"
                           styleClass="login-info-text" />
                    <Label text="Emergency Control Centre and System Administrator accounts are managed by an administrator."
                           wrapText="true"
                           styleClass="login-info-text" />
                </VBox>

            </VBox>

            <VBox alignment="CENTER" spacing="14.0"
                  prefWidth="460.0"
                  styleClass="login-card">

                <Label text="Create an account"
                       styleClass="login-title" />

                <Label text="Complete the form below."
                       styleClass="login-subtitle" />

                <VBox spacing="7.0" maxWidth="340.0">
                    <Label text="Full Name" styleClass="form-label" />
                    <TextField fx:id="fullNameField"
                               promptText="Enter full name"
                               styleClass="login-field" />
                </VBox>
                
                <VBox spacing="7.0" maxWidth="340.0">
                    <Label text="Email" styleClass="form-label" />
                    <TextField fx:id="emailField"
                               promptText="Enter email address"
                               styleClass="login-field" />
                </VBox>

                <VBox spacing="7.0" maxWidth="340.0">
                    <Label text="Contact Number" styleClass="form-label" />
                    <TextField fx:id="contactNumberField"
                               promptText="Enter contact number"
                               styleClass="login-field" />
                </VBox>

                <VBox spacing="7.0" maxWidth="340.0">
                    <Label text="Username" styleClass="form-label" />
                    <TextField fx:id="usernameField"
                               promptText="Choose username"
                               styleClass="login-field" />
                </VBox>

                <VBox spacing="7.0" maxWidth="340.0">
                    <Label text="Password" styleClass="form-label" />
                    <PasswordField fx:id="passwordField"
                                   promptText="Enter password"
                                   styleClass="login-field" />
                </VBox>

                <VBox spacing="7.0" maxWidth="340.0">
                    <Label text="Confirm Password" styleClass="form-label" />
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Confirm password"
                                   styleClass="login-field" />
                </VBox>

                <Button text="Create Public Account"
                        maxWidth="340.0"
                        onAction="#handleRegister"
                        styleClass="login-primary-button" />

                <Button text="Back to Sign In"
                        maxWidth="340.0"
                        onAction="#handleBackToLogin"
                        styleClass="login-secondary-button" />

                <Label fx:id="registrationStatusLabel"
                       text=""
                       wrapText="true"
                       maxWidth="340.0"
                       styleClass="login-status-label" />

            </VBox>

        </HBox>
    </center>

</BorderPane>
